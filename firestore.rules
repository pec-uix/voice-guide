rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email));
    }

    // Admin whitelist — server-only, no direct client access
    match /admin_users/{email} {
      allow read, write: if false;
    }

    // Exhibitions — public read, admin write
    match /exhibitions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Artworks — public read, admin write
    match /artworks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /artworks/{id}/translations/{lang} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /artworks/{id}/transcript_segments/{segId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /artworks/{id}/transcript_segments/{segId}/texts/{lang} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Events — server writes only, admin read
    match /events/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Exhibition feedback — anyone can submit, admin can read/manage
    match /exhibition_feedback/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
